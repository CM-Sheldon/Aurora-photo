<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <title>Aurora · Local Photo Viewer</title>
  <!-- PWA / add-to-home-screen -->
  <link rel="manifest" href="/aurora-manifest.json">
  <meta name="theme-color" content="#06060c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Aurora">
  <link rel="apple-touch-icon" href="/aurora-icon-180.png">
  <!-- Apply the saved theme before first paint so there's no flash of the
       default before /me returns the account's real preference. -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('aurora.theme');
        if (t === 'light' || t === 'dark' || t === 'purple') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/ui/aurora.css?v=<%= encodeURIComponent(typeof appVersion !== 'undefined' ? appVersion.build : 'dev') %>">
</head>
<body>
  <div class="aurora-bg"><span></span><span></span><span></span></div>

  <!-- Debug perf HUD: hidden unless ?debug=1 (persisted). See initPerfHud(). -->
  <div id="perfHud"></div>

  <div class="app">
    <!-- Sidebar -->
    <aside class="sidebar">
      <button type="button" class="sidebar-collapse" id="sidebarCollapseBtn" onclick="toggleSidebar()" title="Collapse sidebar" aria-label="Collapse sidebar">‹</button>
      <div class="sidebar-logo">
        <div class="logo-icon">✦</div>
        <div>
          <div class="logo-text">Aurora</div>
          <div class="logo-sub">LOCAL · PHOTO</div>
        </div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-item active" data-screen="library" data-tip="Library">
          <span class="nav-icon">▦</span><span class="nav-label">Library</span>
          <span class="nav-badge" id="navBadgeLibrary">—</span>
        </div>
        <div class="nav-item" data-screen="places" data-tip="Places">
          <span class="nav-icon">◎</span><span class="nav-label">Places</span>
          <span class="nav-badge" id="navBadgePlaces">—</span>
        </div>
        <div class="nav-item" data-screen="search" data-tip="Search">
          <span class="nav-icon">⌕</span><span class="nav-label">Search</span>
        </div>
        <div class="nav-item" data-screen="albums" data-tip="Albums">
          <span class="nav-icon">⊞</span><span class="nav-label">Albums</span>
        </div>
        <div class="nav-section" data-perm-any="settings.view users.manage audit.view photos.hidden">System</div>
        <div class="nav-item" data-screen="settings" data-perm-any="settings.view users.manage audit.view photos.hidden" data-tip="Settings &amp; Import">
          <span class="nav-icon">⚙</span><span class="nav-label">Settings &amp; Import</span>
        </div>
      </nav>

      <div class="sidebar-stats" id="sidebarStats">
        <div class="stat-row"><span class="stat-label">Photos</span><span class="stat-val" id="statPhotos">—</span></div>
        <div class="stat-row"><span class="stat-label">Videos</span><span class="stat-val" id="statVideos">—</span></div>
        <div class="stat-row"><span class="stat-label">Places</span><span class="stat-val" id="statPlaces">—</span></div>
        <div class="stat-row"><span class="stat-label">Storage</span><span class="stat-val" id="statStorage">—</span></div>
      </div>
    </aside>

    <!-- Main -->
    <main class="main">

      <!-- LIBRARY -->
      <div class="screen active" id="screen-library">
        <!-- Peek handle: appears when the toolbar auto-hides on scroll; click to bring it back. -->
        <div class="chrome-peek" id="libChromePeek" onclick="expandLibChrome()" title="Show toolbar" role="button" tabindex="0">⌄</div>
        <!-- The toolbar + time-range are an absolute OVERLAY (see .lib-chrome): they
             slide up out of view on scroll-down and back down on scroll-up WITHOUT
             resizing the gallery, so the photos never shift under you. The grid is
             given a matching top inset (--lib-inset) so its first row sits below. -->
        <div class="lib-chrome" id="libChrome">
        <div class="topbar">
          <span class="topbar-title">Library</span>
          <span class="topbar-count" id="libraryCount">— items</span>
          <div class="topbar-spacer"></div>
          <div class="tab-group">
            <button class="tab-btn active" data-filter="all">All</button>
            <button class="tab-btn" data-filter="photo">Photos</button>
            <button class="tab-btn" data-filter="video">Videos</button>
            <button class="tab-btn" data-filter="fav">Favorites</button>
          </div>
          <button class="btn btn-ghost" id="libSelectBtn" data-perm-any="photos.tag photos.download photos.hidden" style="font-size:12px;margin-left:8px;" onclick="toggleSelectMode()">Select</button>
        </div>
        <div class="library-controls">
          <div class="slider-row">
            <span class="slider-label">Time range</span>
            <div class="range-wrap dual-range">
              <div class="histogram" id="histogram"></div>
              <div class="dual-track" id="dualTrack">
                <div class="dual-fill" id="dualFill"></div>
                <input type="range" id="timeFrom" min="0" max="100" value="0" aria-label="Range start">
                <input type="range" id="timeTo" min="0" max="100" value="100" aria-label="Range end">
              </div>
              <div class="range-ticks" id="rangeTicks"></div>
            </div>
            <button class="slider-value" id="timeRangeLabel" type="button" title="Reset to all time">All time</button>
          </div>
          <div class="grid-density-row">
            <span class="density-label">Grid size</span>
            <input type="range" id="densitySlider" min="80" max="280" value="180" step="20">
            <span class="density-label" style="margin-left:8px;" id="densityVal">180px</span>
          </div>
        </div>
        </div><!-- /.lib-chrome -->
        <!-- The scroll-position date pill is pinned to the screen (NOT inside the
             scrolling grid) so the grid's top inset can't shove it down the page. -->
        <div class="floating-month" id="floatingMonth"></div>
        <div class="photo-grid-wrap" id="photoGridWrap">
          <div class="empty-state" id="libraryLoading">
            <div class="empty-icon" style="animation:spin 1s linear infinite;display:inline-block;">◌</div>
          </div>
          <div class="empty-state" id="libraryEmpty" style="display:none;">
            <div class="empty-icon">✦</div>
            <div class="empty-title">No photos yet</div>
            <div class="empty-desc">Import a folder to start building your library. Aurora indexes metadata without touching your originals.</div>
            <button class="btn" onclick="switchScreen('settings')">Import photos</button>
          </div>
          <div id="photoGrid"></div>
        </div>
      </div>

      <!-- PLACES -->
      <div class="screen" id="screen-places">
        <div class="topbar">
          <span class="topbar-title">Places</span>
          <span class="topbar-count" id="placesCount">— locations</span>
        </div>
        <div class="library-controls places-controls" id="placesControls" style="display:none;">
          <div class="slider-row" style="margin-bottom:0;">
            <span class="slider-label">Time range</span>
            <div class="range-wrap dual-range">
              <div class="dual-track" id="pDualTrack">
                <div class="dual-fill" id="pDualFill"></div>
                <input type="range" id="pTimeFrom" min="0" max="100" value="0" aria-label="Places range start">
                <input type="range" id="pTimeTo" min="0" max="100" value="100" aria-label="Places range end">
              </div>
              <div class="range-ticks" id="pRangeTicks"></div>
            </div>
            <button class="slider-value" id="pTimeRangeLabel" type="button" title="Reset to all time">All time</button>
          </div>
        </div>
        <div class="places-layout">
          <div class="map-area" id="mapArea">
            <div class="map-placeholder" id="mapPlaceholder">
              <div style="font-size:40px;opacity:0.2">◎</div>
              <div style="font-size:13px;color:var(--text-muted)">No geotagged photos yet</div>
            </div>
            <svg class="world-map" id="worldMap" preserveAspectRatio="xMidYMid meet"></svg>
            <div class="map-labels" id="mapLabels"></div>
            <div class="place-pins" id="placePins"></div>
            <div class="map-controls">
              <button class="map-ctrl" onclick="mapZoomBtn(1)" title="Zoom in">+</button>
              <button class="map-ctrl" onclick="mapZoomBtn(-1)" title="Zoom out">−</button>
              <button class="map-ctrl" onclick="resetMapView()" title="Reset view">⌂</button>
            </div>
            <div class="map-hint">Scroll or pinch to zoom · drag to pan</div>
          </div>
          <div class="place-detail" id="placeDetail" style="display:none;">
            <div class="place-detail-header">
              <div class="place-detail-name" id="placeDetailName">—</div>
              <div class="place-detail-meta" id="placeDetailMeta">—</div>
              <button class="btn" id="placeViewAllBtn" style="margin-top:12px;width:100%;font-size:13px;" onclick="placeViewAll()" disabled>View all photos →</button>
            </div>
            <div class="place-detail-preview-label">Preview</div>
            <div class="place-mini-grid" id="placeDetailGrid"></div>
          </div>
        </div>
      </div>

      <!-- SEARCH -->
      <div class="screen" id="screen-search">
        <div class="topbar">
          <span class="topbar-title">Search</span>
          <span class="topbar-count" id="searchCount"></span>
          <div class="topbar-spacer"></div>
          <button class="btn btn-ghost" id="searchSelectBtn" data-perm-any="photos.tag photos.download photos.hidden" style="font-size:12px;" onclick="toggleSelectMode()">Select</button>
        </div>
        <div class="search-wrap-inner">
          <div class="search-input-wrap" style="padding-top:14px;">
            <span class="search-icon" id="searchIcon">⌕</span>
            <input type="text" class="search-input" id="searchInput" placeholder="Search — places, dates, tags, or describe a photo (e.g. girl holding a coffee)">
          </div>
          <div class="search-chips" id="searchChips"></div>
          <button class="search-filter-toggle" id="searchFilterToggle" onclick="toggleSearchFilters()">⚙ Filters <span class="ft-count" id="searchFilterCount">0</span></button>
          <div class="search-layout">
            <div class="search-sidebar">
              <div class="filter-section">
                <div class="filter-title">Show</div>
                <div class="filter-chips">
                  <span class="chip active" data-search-filter="kind" data-val="">All</span>
                  <span class="chip" data-search-filter="kind" data-val="photo">Photos</span>
                  <span class="chip" data-search-filter="kind" data-val="video">Videos</span>
                  <span class="chip" id="favChip" onclick="toggleFavFilter(this)">★ Favourites</span>
                </div>
              </div>
              <div class="filter-section">
                <div class="filter-title">Cameras</div>
                <div class="filter-chips" id="cameraChips">
                  <span style="font-size:11px;color:var(--text-faint)">Loading…</span>
                </div>
              </div>
              <div class="filter-section">
                <div class="filter-title">Countries</div>
                <div class="filter-chips" id="countryChips">
                  <span style="font-size:11px;color:var(--text-faint)">Loading…</span>
                </div>
              </div>
              <div class="filter-section" id="tagFilterSection" style="display:none;">
                <div class="filter-title">Tags</div>
                <div class="filter-chips" id="tagChips"></div>
              </div>
            </div>
            <!-- Hidden album banner (shown when browsing hidden photos) -->
            <div class="hidden-banner" id="hiddenBanner" style="display:none;">
              <span class="hidden-banner-label">🔒 Hidden Photos</span>
              <button class="btn btn-ghost" style="font-size:12px;" onclick="exitHiddenMode()">Exit ✕</button>
            </div>

            <div class="search-results" id="searchResults">
              <div class="results-header" id="searchHeader" style="display:none;">
                <span class="results-count" id="searchResultsCount">—</span>
                <span class="active-filter" id="searchPlaceFilter" style="display:none;">
                  <span id="searchPlaceFilterName"></span>
                  <button onclick="clearSearchPlace()" title="Clear place filter">✕</button>
                </span>
                <span class="results-note" id="searchCorrected"></span>
              </div>
              <div class="photo-grid" id="searchGrid"></div>
              <div class="empty-state" id="searchEmpty" style="display:none;">
                <div class="empty-icon">⌕</div>
                <div class="empty-title">No results</div>
                <div class="empty-desc">Try fewer or different words — search matches places, cameras, years, and file names, and tolerates typos.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ALBUMS -->
      <div class="screen" id="screen-albums">
        <div class="topbar">
          <span class="topbar-title">Albums</span>
          <div class="topbar-spacer"></div>
          <button class="btn btn-ghost" data-perm="albums.manage" style="font-size:12px;" onclick="createAlbumPrompt()">＋ New album</button>
        </div>
        <div class="albums-content" id="albumsHome">
          <div class="albums-section-title" id="memoriesTitle" style="display:none;">On This Day</div>
          <div class="memories-strip" id="memoriesStrip" style="display:none;"></div>
          <div class="albums-section-title">My Albums</div>
          <div class="events-grid" id="myAlbumsGrid"></div>
          <div class="albums-empty" id="myAlbumsEmpty" style="display:none;">No albums yet — select photos in the Library and tap “⊞ Album”, or create one here.</div>
          <div class="albums-section-title">Smart Albums</div>
          <div class="smart-albums" id="smartAlbums"></div>
          <div class="albums-section-title">Memories by Month</div>
          <div class="events-grid" id="eventsGrid"></div>
        </div>
        <!-- Album detail (swaps with albumsHome) -->
        <div class="albums-content" id="albumDetail" style="display:none;">
          <div class="album-detail-head">
            <button class="btn btn-ghost" style="flex-shrink:0;" onclick="closeAlbumDetail()">←</button>
            <div style="flex:1;min-width:0;">
              <div class="album-detail-name" id="albumDetailName">—</div>
              <div class="album-detail-meta" id="albumDetailMeta">—</div>
            </div>
            <div class="album-detail-actions" data-perm="albums.manage">
              <button class="btn btn-ghost" id="albumEditBtn" onclick="toggleAlbumEdit()">Edit</button>
              <button class="btn btn-ghost" onclick="toggleAlbumShare()">⤴ Share link</button>
              <button class="btn btn-ghost" onclick="renameAlbum()">Rename</button>
              <button class="btn btn-ghost album-danger" onclick="deleteAlbum()">Delete</button>
            </div>
          </div>
          <div class="album-share-row" id="albumShareRow" style="display:none;">
            <input id="albumShareUrl" readonly onclick="this.select()">
            <button class="btn" style="flex-shrink:0;" onclick="copyAlbumShare()">Copy link</button>
            <button class="btn btn-ghost" style="flex-shrink:0;" onclick="revokeAlbumShare()">Stop sharing</button>
          </div>
          <div class="album-grid" id="albumGrid"></div>
          <div class="albums-empty" id="albumEmpty" style="display:none;">This album is empty — select photos in the Library and tap “⊞ Album”.</div>
        </div>
      </div>

      <!-- SETTINGS -->
      <div class="screen" id="screen-settings">
        <div class="topbar">
          <span class="topbar-title">Settings</span>
          <span class="topbar-count" id="settingsVersionTag"></span>
          <div class="topbar-spacer"></div>
          <button class="btn btn-ghost" id="settingsRefreshBtn" style="font-size:12px;" onclick="loadSettings(this)">↻ Refresh</button>
        </div>
        <div class="settings-content">

          <!-- Sub-tab bar -->
          <div class="settings-tabs">
            <button class="stab active" data-stab="library" data-perm="settings.view" onclick="switchSettingsTab(this)">Library</button>
            <button class="stab" data-stab="import" data-perm="settings.manage" onclick="switchSettingsTab(this)">Import</button>
            <button class="stab" data-stab="manage" data-perm="settings.manage" onclick="switchSettingsTab(this)">Manage</button>
            <button class="stab" data-stab="privacy" data-perm="photos.hidden" onclick="switchSettingsTab(this)">Privacy</button>
            <button class="stab" data-stab="duplicates" data-perm="settings.view" onclick="switchSettingsTab(this)">Duplicates</button>
            <button class="stab" data-stab="system" data-perm="settings.manage" onclick="switchSettingsTab(this)">System</button>
            <button class="stab admin-only" data-stab="users" onclick="switchSettingsTab(this)" style="display:none;">Users &amp; roles</button>
            <button class="stab admin-only" data-stab="audit" onclick="switchSettingsTab(this)" style="display:none;">Audit log</button>
          </div>

          <!-- ── LIBRARY TAB ── -->
          <div class="stab-panel active" id="stab-library">
            <div class="settings-grid" id="settingsMetrics">
              <div style="color:var(--text-faint);font-size:13px;">Loading metrics…</div>
            </div>
            <div class="settings-section-title" style="margin-top:20px;">Display</div>
            <div class="import-card">
              <div class="import-card-title">Options</div>
              <label class="settings-toggle">
                <input type="checkbox" id="toggleHideRaw" onchange="setHideRaw(this.checked)">
                <span>Hide RAW photos <span style="color:var(--text-muted)">(.cr2 / .nef / .arw / .dng — can't be previewed in a browser)</span></span>
              </label>
            </div>
            <div class="import-card" data-perm="photos.delete">
              <div class="import-card-title">Removed items</div>
              <div class="card-help">Photos you removed from the library are hidden everywhere and won't re-import — but the original files are kept. Review them here and restore any that were removed by mistake.</div>
              <button class="btn btn-ghost" style="margin-top:12px;" onclick="openRemovedManager()">Manage removed<span id="removedCountTag" style="color:var(--text-muted);"></span></button>
            </div>
          </div>

          <!-- ── IMPORT TAB ── -->
          <div class="stab-panel" id="stab-import">
            <div class="import-card">
              <div class="import-card-title">Add a source</div>
              <div class="card-help">Connect a network share or point at a folder on the server. Aurora mounts it <b>read-only</b> — your original files are never modified.</div>

              <div class="tab-group" style="margin-bottom:16px;width:fit-content;">
                <button class="tab-btn active" data-proto="smb" onclick="setProto('smb',this)">SMB / Windows</button>
                <button class="tab-btn" data-proto="nfs" onclick="setProto('nfs',this)">NFS</button>
                <button class="tab-btn" data-proto="local" onclick="setProto('local',this)">Local path</button>
              </div>

              <div id="proto-smb">
                <div class="import-field-row">
                  <div class="import-field">
                    <label class="field-label">Host / IP</label>
                    <input type="text" class="path-input" id="smbHost" placeholder="192.168.1.50">
                  </div>
                  <div class="import-field">
                    <label class="field-label">Share name</label>
                    <input type="text" class="path-input" id="smbShare" placeholder="Photos">
                  </div>
                </div>
                <div class="import-field-row" style="margin-top:10px;">
                  <div class="import-field">
                    <label class="field-label">Username <span style="color:var(--text-faint)">(optional)</span></label>
                    <input type="text" class="path-input" id="smbUser" placeholder="guest" autocomplete="off">
                  </div>
                  <div class="import-field">
                    <label class="field-label">Password <span style="color:var(--text-faint)">(optional)</span></label>
                    <input type="password" class="path-input" id="smbPass" autocomplete="off">
                  </div>
                  <div class="import-field" style="max-width:140px;">
                    <label class="field-label">Domain <span style="color:var(--text-faint)">(optional)</span></label>
                    <input type="text" class="path-input" id="smbDomain" placeholder="WORKGROUP">
                  </div>
                </div>
              </div>

              <div id="proto-nfs" style="display:none;">
                <div class="import-field-row">
                  <div class="import-field">
                    <label class="field-label">Host / IP</label>
                    <input type="text" class="path-input" id="nfsHost" placeholder="192.168.1.50">
                  </div>
                  <div class="import-field">
                    <label class="field-label">Export path</label>
                    <input type="text" class="path-input" id="nfsExport" placeholder="/export/photos">
                  </div>
                </div>
              </div>

              <div id="proto-local" style="display:none;">
                <div class="import-field-row">
                  <div class="import-field">
                    <label class="field-label">Server-local path</label>
                    <input type="text" class="path-input" id="localPath" placeholder="/mnt/photos">
                  </div>
                </div>
              </div>

              <div style="margin-top:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <button class="btn" id="mountBtn" onclick="doMount()">Connect &amp; Mount</button>
                <div id="mountStatus" class="action-status"></div>
              </div>
              <div class="card-help" style="margin-top:10px;">🔒 Connected shares are remembered and re-mounted automatically after a reboot (credentials are stored in a root-only file, never in the database). Re-connecting a share you've imported before re-links to your existing photos — no need to re-import.</div>
            </div>

            <div class="import-card" id="connectedSharesCard" style="display:none;">
              <div class="import-card-title">Connected shares</div>
              <div class="card-help">Shares currently mounted on the server. <b>Use</b> sets one as the scan source; <b>Unmount</b> disconnects it.</div>
              <div id="connectedSharesList"></div>
            </div>

            <div class="import-card" id="mountedSourceCard" style="display:none;">
              <div class="import-card-title">Scan &amp; index</div>
              <div class="card-help">Reads photo &amp; video metadata from the source below and builds the searchable library. Thumbnails are generated as you browse.</div>
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                <div style="font-family:var(--font-mono);font-size:12px;background:rgba(125,211,252,0.08);border:1px solid rgba(125,211,252,0.2);border-radius:8px;padding:8px 14px;flex:1;color:var(--accent-sky);" id="mountedPathDisplay">—</div>
                <button class="btn btn-ghost" style="font-size:12px;" onclick="clearMount()">Clear</button>
              </div>
              <button class="btn" id="importBtn" onclick="startImport()">Scan &amp; Index</button>
            </div>

            <div class="import-card" id="importProgress" style="display:none;">
              <div class="import-card-title">Indexing pipeline</div>
              <div class="kpi-row">
                <div class="kpi"><div class="kpi-val" id="kpiScanned">0</div><div class="kpi-label">Scanned</div></div>
                <div class="kpi"><div class="kpi-val" id="kpiIndexed">0</div><div class="kpi-label">Indexed</div></div>
                <div class="kpi"><div class="kpi-val" id="kpiSkipped">0</div><div class="kpi-label">Skipped</div></div>
                <div class="kpi"><div class="kpi-val" id="kpiErrors">0</div><div class="kpi-label">Errors</div></div>
              </div>
              <div class="progress-bar-wrap"><div class="progress-bar" id="progressBar" style="width:0%"></div></div>
              <div class="pipeline-stages">
                <div class="stage" id="stageScanning"><span class="stage-icon">🔍</span><span class="stage-name">Scanning filesystem</span><span class="stage-status" id="stageScanningStatus">Waiting</span></div>
                <div class="stage" id="stageIndexing"><span class="stage-icon">⚡</span><span class="stage-name">Extracting EXIF + metadata</span><span class="stage-status" id="stageIndexingStatus">Waiting</span></div>
                <div class="stage" id="stageThumbs"><span class="stage-icon">🖼</span><span class="stage-name">Thumbnails</span><span class="stage-status" id="stageThumbsStatus">On-demand while browsing</span></div>
                <div class="stage" id="stageGeo"><span class="stage-icon">📍</span><span class="stage-name">Reverse geocoding GPS</span><span class="stage-status" id="stageGeoStatus">During index</span></div>
              </div>
              <div class="log-feed" id="logFeed"></div>
            </div>

            <div class="import-card">
              <div class="import-card-title">Re-index metadata</div>
              <div class="card-help">Re-reads EXIF for an already-imported source — useful after an upgrade. Mount the share above first, then re-index it here.</div>
              <div id="reindexSources"></div>
            </div>

            <div class="import-card">
              <div class="import-card-title">Recent imports</div>
              <div id="settingsImports"></div>
            </div>
          </div>

          <!-- ── MANAGE TAB ── -->
          <div class="stab-panel" id="stab-manage">
            <div class="settings-section-title">Tags</div>
            <div class="import-card">
              <div class="import-card-title">Manage tags</div>
              <div class="card-help">Rename a tag to update it across every photo (renaming onto an existing tag <b>merges</b> the two), or delete a tag to remove it everywhere. To tag many photos at once, use <b>Select</b> on the Library or Search screen.</div>
              <div id="tagManager"><span style="font-size:12px;color:var(--text-faint)">Loading…</span></div>
            </div>

            <div class="settings-section-title">Content recognition</div>
            <div class="import-card">
              <div class="import-card-title">Photo descriptions <span style="font-weight:400;color:var(--text-faint);font-size:12px;">· natural-language search</span></div>
              <div class="card-help">Writes a short description of each photo with a vision&nbsp;AI model so you can search in plain English — e.g. <b>“girl holding a coffee”</b> or <b>“dog on a beach”</b> — and combine it with places and dates. The model runs on your <b>Ollama</b> server; this app only stores and searches the text. Progress is saved, so it resumes after a stop or restart.</div>

              <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:14px;">
                <button class="btn" id="capStartBtn" onclick="capStart(this)">Start</button>
                <button class="btn btn-ghost" id="capStopBtn" onclick="capStop(this)" style="display:none;">Stop</button>
                <div id="capStatus" class="action-status"></div>
              </div>
              <div id="capProgress" style="display:none;margin-top:12px;">
                <div class="progress-bar-wrap"><div class="progress-bar" id="capProgressBar" style="width:0%"></div></div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:4px;" id="capProgressLabel">—</div>
              </div>

              <!-- Live monitor: last image captioned + recent activity -->
              <div id="capMonitor" style="display:none;margin-top:16px;">
                <div class="cap-last">
                  <img id="capLastThumb" class="cap-last-thumb" alt="">
                  <div class="cap-last-text">
                    <div class="cap-last-cap" id="capLastCap"></div>
                    <div class="cap-last-meta" id="capLastMeta"></div>
                  </div>
                </div>
                <div class="cap-log-title">Recent activity</div>
                <div id="capLog" class="cap-log"></div>
              </div>

              <!-- Model & server settings (collapsible) -->
              <details class="cap-settings" id="capSettings">
                <summary>Model &amp; server settings</summary>
                <div class="cap-set-grid">
                  <label>Ollama server
                    <input type="text" id="capUrl" class="path-input" placeholder="http://localhost:11434" autocomplete="off" spellcheck="false">
                  </label>
                  <label>Model
                    <div style="display:flex;gap:8px;align-items:center;">
                      <select id="capModel" class="path-input" style="flex:1;"></select>
                      <button class="btn btn-ghost" id="capTestBtn" onclick="capTestConnection(this)" style="white-space:nowrap;font-size:12px;">Test</button>
                    </div>
                    <div id="capModelHint" style="font-size:11px;color:var(--text-faint);margin-top:4px;"></div>
                  </label>
                  <label>Description style
                    <select id="capStyle" class="path-input"></select>
                  </label>
                  <label>Parallel requests
                    <select id="capConc" class="path-input">
                      <option value="1">1 (gentlest)</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4 (fastest)</option>
                    </select>
                  </label>
                </div>
                <div style="margin-top:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                  <button class="btn" id="capSaveBtn" onclick="capSaveConfig(this)">Save settings</button>
                  <div id="capSaveStatus" class="action-status"></div>
                </div>
                <div class="card-help" style="margin-top:10px;">Settings can be saved any time; changes apply when captioning next starts. Use a <b>vision</b> model (e.g. <code>qwen2.5vl:3b</code>) — text-only models can’t read images.</div>
              </details>
            </div>

            <div class="settings-section-title">Maintenance</div>
            <div class="import-card">
              <div class="import-card-title">One-click actions</div>
              <div class="settings-actions">
                <button class="btn" id="btnWarm" onclick="settingsWarm(this)">Warm thumbnails</button>
                <button class="btn btn-ghost" id="btnWarmStop" style="display:none;" onclick="settingsWarmStop(this)">■ Stop warming</button>
                <button class="btn btn-ghost" id="btnRelink" onclick="settingsRelink(this)">Re-link Live Photos</button>
                <button class="btn btn-ghost" id="btnGeocode" onclick="settingsGeocode(this)">Name places on map</button>
              </div>
              <div id="warmProgressLine" class="card-help" style="margin-top:10px;display:none;"></div>
              <label class="card-help" style="display:flex;align-items:center;gap:8px;margin-top:12px;cursor:pointer;">
                <input type="checkbox" id="warmOnBootChk" checked onchange="settingsWarmBootPref(this)">
                <span>Warm thumbnails automatically after each restart</span>
              </label>
              <div class="card-help" style="margin-top:12px;">
                <b>Warm thumbnails</b> pre-generates previews so browsing is instant; stopping is safe — it resumes where it left off next time.&nbsp;
                <b>Re-link Live Photos</b> re-pairs stills with their motion clips.&nbsp;
                <b>Name places on map</b> fills in place names from the offline cities dataset.
              </div>
              <div id="settingsActionStatus" class="action-status" style="margin-top:12px;"></div>
            </div>
          </div>

          <!-- ── PRIVACY TAB ── -->
          <div class="stab-panel" id="stab-privacy">
            <div class="import-card">
              <div class="import-card-title">Passcode</div>
              <div class="card-help">Protects the <b>Hidden</b> album. Required to view hidden photos. Default is <code>0000</code>.</div>
              <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-top:12px;">
                <div>
                  <label class="field-label">New passcode</label>
                  <input type="password" class="path-input" id="newPasscode" placeholder="0000" maxlength="20" inputmode="numeric" autocomplete="new-password" style="width:130px;">
                </div>
                <div>
                  <label class="field-label">Confirm</label>
                  <input type="password" class="path-input" id="confirmPasscode" placeholder="0000" maxlength="20" inputmode="numeric" autocomplete="new-password" style="width:130px;">
                </div>
                <button class="btn" onclick="changePasscode()">Set passcode</button>
              </div>
              <div id="passcodeSetStatus" class="action-status" style="margin-top:8px;"></div>
            </div>

            <div class="import-card">
              <div class="import-card-title">Hidden photos</div>
              <div class="card-help">Photos you mark as hidden are invisible in the Library and Search — they're only accessible through the <b>Hidden</b> album in Albums after entering your passcode. They are never deleted.</div>
              <div id="privacyStats" style="margin-top:8px;font-size:13px;color:var(--text-muted);">Loading…</div>
              <button class="btn btn-ghost" style="margin-top:10px;font-size:12px;" onclick="loadPrivacyStats()">↻ Refresh count</button>
            </div>
          </div>

          <!-- ── DUPLICATES TAB ── -->
          <div class="stab-panel" id="stab-duplicates">
            <div class="import-card">
              <div class="import-card-title">Duplicate Detection</div>
              <div class="card-help">Scans for exact duplicate files across your library (same content, any filename or path). Duplicates are hidden from Library and Search but <b>never deleted</b>.</div>

              <div style="margin-top:14px;margin-bottom:14px;">
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;font-weight:500;">Resolution mode</div>
                <div style="display:flex;gap:20px;flex-wrap:wrap;">
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;">
                    <input type="radio" name="dupMode" id="dupModeAuto" value="auto" checked>
                    <span><b>Auto</b> — keep largest file, hide the rest immediately</span>
                  </label>
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;">
                    <input type="radio" name="dupMode" id="dupModeManual" value="manual">
                    <span><b>Manual</b> — review each group and choose which to keep</span>
                  </label>
                </div>
              </div>

              <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <button class="btn" id="dupScanBtn" onclick="startDupScan()">Scan for duplicates</button>
                <div id="dupScanStatus" class="action-status"></div>
              </div>
              <div id="dupProgress" style="display:none;margin-top:12px;">
                <div class="progress-bar-wrap"><div class="progress-bar" id="dupProgressBar" style="width:0%"></div></div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:4px;" id="dupProgressLabel">—</div>
              </div>

              <div style="margin-top:18px;padding-top:16px;border-top:1px solid var(--border);">
                <div style="font-size:13px;color:var(--text);font-weight:500;margin-bottom:4px;">Re-encoded &amp; Live Photo copies</div>
                <div class="card-help" style="margin-top:0;">Finds the <b>same photo saved twice</b> at different compression (so the bytes differ and the exact scan above misses them) — e.g. a Live Photo and a re-exported JPEG copy. Matches on capture time, camera, dimensions and filename. The copy <b>with Live Photo motion is always kept</b> (then the largest file). Hidden, never deleted.</div>
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px;">
                  <button class="btn" id="dupSimilarBtn" onclick="startSimilarScan()">Find re-encoded copies</button>
                  <div id="dupSimilarStatus" class="action-status"></div>
                </div>
              </div>
            </div>

            <div id="dupGroupsCard" style="display:none;">
              <div class="import-card">
                <div class="import-card-title">Duplicate groups</div>
                <div class="card-help">Each group contains files with identical content. Click <b>Keep this</b> to mark that copy as the one to keep — the others are hidden from your library.</div>
                <div id="dupGroups"></div>
              </div>
            </div>
          </div>

          <!-- ── SYSTEM TAB ── -->
          <!-- ── USERS & ROLES TAB (admin only) ── -->
          <div class="stab-panel" id="stab-users">
            <div class="import-card">
              <div class="import-card-title">Users</div>
              <div class="card-help">Add people who can sign in to Aurora. Each user gets a role that decides what they can do.</div>
              <div class="rbac-table-wrap"><table class="rbac-table" id="usersTable"><thead>
                <tr><th>Username</th><th>Role</th><th>Status</th><th>Last seen</th><th></th></tr>
              </thead><tbody><tr><td colspan="5" style="color:var(--text-faint);">Loading…</td></tr></tbody></table></div>
              <button class="btn" style="margin-top:12px;" onclick="openUserAddDialog()">+ Add user</button>
            </div>
            <div class="import-card">
              <div class="import-card-title">Roles</div>
              <div class="card-help">Built-in <b>admin</b> and <b>user</b> roles cover most needs. Create custom roles for finer-grained permissions.</div>
              <div class="rbac-table-wrap"><table class="rbac-table" id="rolesTable"><thead>
                <tr><th>Name</th><th>Type</th><th>Permissions</th><th></th></tr>
              </thead><tbody><tr><td colspan="4" style="color:var(--text-faint);">Loading…</td></tr></tbody></table></div>
              <button class="btn" style="margin-top:12px;" onclick="openRoleDialog()">+ New role</button>
            </div>
          </div>

          <!-- ── AUDIT LOG TAB (admin only) ── -->
          <div class="stab-panel" id="stab-audit">
            <div class="import-card">
              <div class="import-card-title">Recent activity</div>
              <div class="card-help">Sign-ins, account &amp; role changes, and everyday actions (favorites, tags, hides, removals, albums, imports, downloads) are all logged here.</div>
              <div class="audit-filter-bar" id="auditFilterBar">
                <button class="audit-chip active" data-cat="" onclick="setAuditFilter(this)">All</button>
                <button class="audit-chip" data-cat="auth" onclick="setAuditFilter(this)">Sign-in</button>
                <button class="audit-chip" data-cat="photo" onclick="setAuditFilter(this)">Photos</button>
                <button class="audit-chip" data-cat="album" onclick="setAuditFilter(this)">Albums</button>
                <button class="audit-chip" data-cat="import" onclick="setAuditFilter(this)">Imports</button>
                <button class="audit-chip" data-cat="admin" onclick="setAuditFilter(this)">Users &amp; roles</button>
              </div>
              <div class="rbac-table-wrap"><table class="rbac-table" id="auditTable"><thead>
                <tr><th>When</th><th>User</th><th>Action</th><th>Target</th><th>Details</th></tr>
              </thead><tbody><tr><td colspan="5" style="color:var(--text-faint);">Loading…</td></tr></tbody></table></div>
              <button class="btn btn-ghost" style="margin-top:12px;" onclick="loadAudit()">↻ Refresh</button>
            </div>
          </div>

          <div class="stab-panel" id="stab-system">
            <!-- ── Software update (GitHub) ── -->
            <div class="import-card">
              <div class="import-card-title">Software update</div>
              <div id="updateVersionLine" style="font-size:13px;color:var(--text-muted);margin-bottom:6px;">Loading version…</div>
              <div class="card-help">Aurora checks GitHub for a new release. Your photo library, thumbnails, tags, favourites and captions live in <code>/var/lib/aurora-photos/</code> and are never touched by an update — plus a rollback snapshot and DB backup are taken before every install, so a failed update automatically reverts to the previous version.</div>

              <div class="update-summary" id="updateSummary">
                <div class="update-status-line" id="updateCheckStatus">Checking for updates…</div>
              </div>

              <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                <button class="btn btn-ghost" id="updateCheckBtn" onclick="checkForUpdates()">↻ Check again</button>
                <button class="btn" id="updateApplyBtn" style="display:none;" onclick="applyGitHubUpdate()">Update now</button>
                <a class="btn btn-ghost" id="updateReleaseLink" href="#" target="_blank" rel="noopener" style="display:none;">Release notes ↗</a>
              </div>

              <details class="update-changelog" id="updateChangelogWrap" style="display:none;">
                <summary>What's new</summary>
                <div class="changelog-body" id="updateChangelog"></div>
              </details>

              <div class="update-status" id="updateStatus"></div>
            </div>

            <!-- ── Advanced: local zip fallback ── -->
            <details class="import-card" id="advancedUpdateCard">
              <summary style="cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);">Advanced — install from a local zip</summary>
              <div class="card-help" style="margin-top:10px;">If the server can't reach GitHub, copy an Aurora update zip onto this box and enter its full path. Same safety net (rollback + DB backup) applies.</div>
              <div class="update-row">
                <input type="text" id="updateZipPath" placeholder="/opt/aurora-updates/aurora-photos-update.zip" autocomplete="off" spellcheck="false">
                <button class="btn" id="updateApplyLocalBtn" onclick="applyUpdate()">Apply Update</button>
              </div>
            </details>
          </div>

        </div>
      </div>

    </main>
  </div>

  <!-- Mobile bottom navigation (iOS-style tab bar) -->
  <nav class="bottom-nav" id="bottomNav">
    <div class="bnav-item active" data-screen="library"><span class="bnav-icon">▦</span><span>Library</span></div>
    <div class="bnav-item" data-screen="places"><span class="bnav-icon">◎</span><span>Places</span></div>
    <div class="bnav-item" data-screen="search"><span class="bnav-icon">⌕</span><span>Search</span></div>
    <div class="bnav-item" data-screen="albums"><span class="bnav-icon">⊞</span><span>Albums</span></div>
    <div class="bnav-item" data-screen="settings" data-perm-any="settings.view users.manage audit.view photos.hidden"><span class="bnav-icon">⚙</span><span>Settings</span></div>
  </nav>

  <!-- RBAC dialog (users / roles). Reuses passcode-overlay backdrop.
       When dataset.forced is '1' (change-PIN required), backdrop clicks are
       ignored so the user can't dismiss the mandatory dialog. -->
  <div class="passcode-overlay" id="rbacOverlay" style="display:none;" onclick="if(event.target===this && !this.dataset.forced) closeRbacDialog()">
    <div class="rbac-dialog" id="rbacDialog"></div>
  </div>

  <!-- Signed-in user menu (logout, etc.) — positioned via .user-menu absolute -->
  <div class="user-menu" id="userMenu"></div>

  <!-- Manage removed items modal -->
  <div class="passcode-overlay" id="removedOverlay" style="display:none;" onclick="if(event.target===this) closeRemovedManager()">
    <div class="removed-card">
      <div class="removed-head">
        <div class="removed-title">Removed items</div>
        <button class="btn btn-ghost" style="font-size:12px;" onclick="closeRemovedManager()">Close</button>
      </div>
      <div class="removed-sub" id="removedSub">Loading…</div>
      <div class="removed-list" id="removedList"></div>
    </div>
  </div>

  <!-- Passcode modal -->
  <div class="passcode-overlay" id="passcodeOverlay" style="display:none;">
    <div class="passcode-card">
      <div class="passcode-title">🔒 Hidden Photos</div>
      <div class="passcode-sub" id="passcodeSubtitle">Enter your passcode to continue</div>
      <input type="password" class="passcode-input" id="passcodeInput" maxlength="20" inputmode="numeric" autocomplete="off" placeholder="••••">
      <div class="passcode-err" id="passcodeErr"></div>
      <div style="display:flex;gap:8px;justify-content:center;">
        <button class="btn" onclick="passcodeSubmit()">Unlock</button>
        <button class="btn btn-ghost" onclick="passcodeCancel()">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <div class="lightbox-chrome" id="lightboxChrome">
      <div class="lightbox-topbar">
        <button class="lb-btn" onclick="closeLightbox()" title="Close">✕</button>
        <div class="lightbox-title" id="lightboxTitle"></div>
        <div class="lb-actions">
          <button class="lb-btn" id="lbLiveBtn" onclick="playLive()" title="Play Live Photo" style="display:none;">◉</button>
          <button class="lb-btn" id="lbFavBtn" data-perm="photos.favorite" onclick="lightboxToggleFav()" title="Favourite">♡</button>
          <button class="lb-btn" id="lbFitBtn" onclick="toggleLightboxFit()" title="Fit / Fill">⤢</button>
          <button class="lb-btn" id="lbInfoBtn" onclick="toggleMetaPanel()" title="Info">ⓘ</button>
        </div>
      </div>
    </div>
    <button class="lightbox-nav lightbox-prev" id="lbPrev" onclick="lightboxNav(-1)">‹</button>
    <button class="lightbox-nav lightbox-next" id="lbNext" onclick="lightboxNav(1)">›</button>
    <div class="lightbox-stage" id="lightboxStage">
      <img id="lightboxImg" src="" style="display:none;" draggable="false">
      <video id="lightboxVideo" controls playsinline style="display:none;"></video>
    </div>
  </div>

  <!-- Metadata panel (side sheet on desktop, bottom sheet on mobile) -->
  <div class="meta-panel" id="metaPanel">
    <div class="meta-panel-header">
      <span>Info</span>
      <button class="lb-btn" onclick="closeMetaPanel()">✕</button>
    </div>
    <div class="meta-panel-body" id="metaPanelBody"></div>
  </div>

  <div class="toast" id="toast"></div>

  <!-- Multi-select action bar (shown while in select mode) -->
  <div class="selection-bar" id="selectionBar">
    <span class="sel-count" id="selCount">0 selected</span>
    <div class="sel-main">
      <button class="sel-btn" onclick="selSelectAll()">Select all</button>
      <button class="sel-btn sel-primary" data-perm="photos.tag" onclick="selStartAddTag()">＋ Add tag</button>
      <button class="sel-btn" data-perm="photos.tag" onclick="selStartRemoveTag()">－ Remove tag</button>
      <button class="sel-btn" data-perm="albums.manage" onclick="selStartAddToAlbum()">⊞ Album</button>
      <button class="sel-btn" id="selPrivateBtn" data-perm="photos.hidden" onclick="selHidePhotos()">🔒 Hide</button>
      <button class="sel-btn" id="selRemoveBtn" data-perm="photos.delete" onclick="selRemovePhotos()">🗑 Remove</button>
      <button class="sel-btn" id="selShareBtn" data-perm="photos.download" onclick="shareSelection()">⤴ Share</button>
      <button class="sel-btn" onclick="exitSelectMode()">Done</button>
    </div>
    <div class="sel-entry" id="selTagEntry" style="display:none;">
      <input id="selTagInput" placeholder="Tag name…" autocomplete="off" spellcheck="false" maxlength="80" onkeydown="if(event.key==='Enter'){event.preventDefault();selApplyAddTag();}">
      <button class="sel-btn sel-primary" id="selAddConfirmBtn" onclick="selApplyAddTag()">Add</button>
      <button class="sel-btn" onclick="cancelSelEntry()">Cancel</button>
    </div>
    <div class="sel-menu" id="selTagMenu" style="display:none;"></div>
  </div>

  <!-- Boot config baked in at render time; everything else lives in /ui/aurora.js -->
  <script>window.AURORA_BOOT = <%- JSON.stringify({ version: typeof appVersion !== 'undefined' ? appVersion.version : 'dev', build: typeof appVersion !== 'undefined' ? appVersion.build : 'dev', cacheEpoch: typeof cacheEpoch !== 'undefined' ? String(cacheEpoch) : '0' }).replace(/</g, '\\u003c') %>;</script>
  <script src="/ui/aurora.js?v=<%= encodeURIComponent(typeof appVersion !== 'undefined' ? appVersion.build : 'dev') %>"></script>
</body>
</html>

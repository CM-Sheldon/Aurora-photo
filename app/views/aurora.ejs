<%
  // Aurora 2 app shell. Markup lives in views/partials/, styles in public/ui/css/,
  // behaviour in public/ui/js/ (classic scripts sharing one global scope, loaded in
  // the order below). Every /ui URL carries ?v=<build> so a deploy busts caches.
  const BUILD = typeof appVersion !== 'undefined' ? appVersion.build : 'dev';
  const V = encodeURIComponent(BUILD);
  const CSS = ['tokens', 'base', 'grid', 'viewer', 'screens', 'settings'];
  const JS = ['core', 'sheets', 'grid', 'library', 'viewer', 'select', 'search', 'places', 'collections', 'settings', 'admin', 'boot'];
  const BOOT = {
    version: typeof appVersion !== 'undefined' ? appVersion.version : 'dev',
    build: BUILD,
    cacheEpoch: typeof cacheEpoch !== 'undefined' ? String(cacheEpoch) : '0',
  };
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <title>Aurora</title>
  <!-- PWA / add-to-home-screen -->
  <link rel="manifest" href="/aurora-manifest.json">
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Aurora">
  <link rel="apple-touch-icon" href="/aurora-icon-180.png">
  <!-- Apply the saved theme before first paint so there's no flash of the default
       before /me returns the account's real preference. -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('aurora.theme');
        if (t === 'light' || t === 'dark' || t === 'purple') document.documentElement.setAttribute('data-theme', t);
        if (localStorage.getItem('aurora.noblur') === '1') document.documentElement.classList.add('no-blur');
      } catch (e) {}
    })();
  </script>
<% CSS.forEach(function (f) { %>  <link rel="stylesheet" href="/ui/css/<%= f %>.css?v=<%= V %>">
<% }) %></head>
<body>
  <%- include('partials/icons') %>
  <!-- Debug perf HUD: hidden unless ?debug=1 (persisted). See boot.js. -->
  <div id="perfHud"></div>

  <div class="app">
    <%- include('partials/sidebar') %>
    <main class="main" id="main">
      <%- include('partials/library') %>
      <%- include('partials/places') %>
      <%- include('partials/collections') %>
      <%- include('partials/search') %>
      <%- include('partials/settings') %>
    </main>
  </div>

  <%- include('partials/tabbar') %>
  <%- include('partials/viewer') %>
  <%- include('partials/overlays') %>

  <!-- Boot config baked in at render time; everything else lives in /ui/js/ -->
  <script>window.AURORA_BOOT = <%- JSON.stringify(BOOT).replace(/</g, '\\u003c') %>;</script>
<% JS.forEach(function (f) { %>  <script src="/ui/js/<%= f %>.js?v=<%= V %>"></script>
<% }) %></body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shared album · Aurora</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#000000">
  <style>
    /* Public shared-album page, styled to match Aurora 2: black canvas,
       edge-to-edge 2px grid, system font. Tiles use aspect-ratio — percentage
       padding squares inside CSS grid collapse to zero height on iOS Safari. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --void: #000; --panel: #1c1b21; --border: rgba(255,255,255,0.12);
      --text: #fff; --text-muted: rgba(235,235,245,0.62);
      --accent: #a78bfa; --accent-sky: #7dd3fc;
      color-scheme: dark;
    }
    html { background: var(--void); }
    body {
      background: var(--void); color: var(--text); min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased; padding-bottom: env(safe-area-inset-bottom);
    }
    .bg { display: none; }
    header { padding: calc(22px + env(safe-area-inset-top)) 16px 14px; }
    .brand { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
    h1 { font-size: 30px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
    .meta { color: var(--text-muted); font-size: 15px; font-weight: 500; margin-top: 3px; }
    main { padding: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 2px; }
    @media (max-width: 520px) { .grid { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 360px) { .grid { grid-template-columns: repeat(3, 1fr); } }
    .tile { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--panel); cursor: pointer; }
    .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tile .vb {
      position: absolute; right: 5px; bottom: 4px; font-size: 12px; font-weight: 600; color: #fff;
      text-shadow: 0 1px 4px rgba(0,0,0,0.75);
    }
    .state { text-align: center; color: var(--text-muted); padding: 80px 20px; font-size: 16px; }
    /* Viewer */
    .lb { position: fixed; inset: 0; z-index: 10; background: #000; display: none; align-items: center; justify-content: center; }
    .lb.open { display: flex; }
    .lb img, .lb video { max-width: 100vw; max-height: 100vh; object-fit: contain; }
    .lb-close, .lb-prev, .lb-next {
      position: absolute; z-index: 11; border: 0.5px solid rgba(255,255,255,0.18); cursor: pointer;
      background: rgba(44,42,52,0.7); color: #fff;
      -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
      width: 44px; height: 44px; border-radius: 50%; font-size: 18px; line-height: 1;
    }
    .lb-close { top: max(14px, env(safe-area-inset-top)); right: 14px; }
    .lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
    .lb-next { right: 12px; top: 50%; transform: translateY(-50%); }
    footer { text-align: center; color: var(--text-muted); font-size: 13px; padding: 26px 0 34px; }
    footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <div class="bg"><span></span><span></span></div>
  <header>
    <div class="brand">✦ Aurora</div>
    <h1 id="albumName">Shared album</h1>
    <div class="meta" id="albumMeta">Loading…</div>
  </header>
  <main>
    <div class="grid" id="grid"></div>
    <div class="state" id="stateMsg" style="display:none;"></div>
  </main>
  <footer>Shared with <span style="color:var(--accent)">Aurora Photos</span></footer>

  <div class="lb" id="lb">
    <button class="lb-close" onclick="closeLb()">✕</button>
    <button class="lb-prev" onclick="step(-1)">‹</button>
    <button class="lb-next" onclick="step(1)">›</button>
    <div id="lbContent"></div>
  </div>

  <script>
    const TOKEN = '<%= token %>';
    const API = '/api/aurora/share/' + TOKEN;
    let items = [], cur = 0;

    function fmtDate(ms) {
      if (!ms) return '';
      return new Date(ms).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
    }

    async function load() {
      const grid = document.getElementById('grid');
      const state = document.getElementById('stateMsg');
      try {
        const res = await fetch(API);
        if (!res.ok) throw new Error('gone');
        const data = await res.json();
        items = data.assets || [];
        document.getElementById('albumName').textContent = data.name;
        document.title = data.name + ' · Aurora';
        const first = items.length ? fmtDate(items[0].taken_at) : '';
        const last = items.length ? fmtDate(items[items.length - 1].taken_at) : '';
        const span = first && last && first !== last ? '  ·  ' + first + ' – ' + last : (first ? '  ·  ' + first : '');
        document.getElementById('albumMeta').textContent =
          data.count + (data.count === 1 ? ' item' : ' items') + span;
        if (!items.length) { state.style.display = 'block'; state.textContent = 'This album is empty.'; return; }
        items.forEach((a, i) => {
          const t = document.createElement('div');
          t.className = 'tile';
          const img = document.createElement('img');
          img.loading = 'lazy'; img.decoding = 'async'; img.alt = '';
          img.src = API + '/thumb/' + a.id;
          t.appendChild(img);
          if (a.kind === 'video') { const b = document.createElement('div'); b.className = 'vb'; b.textContent = '▶'; t.appendChild(b); }
          t.addEventListener('click', () => openLb(i));
          grid.appendChild(t);
        });
      } catch (_) {
        document.getElementById('albumMeta').textContent = '';
        state.style.display = 'block';
        state.textContent = 'This share link is no longer available.';
      }
    }

    function renderLb() {
      const c = document.getElementById('lbContent');
      c.innerHTML = '';
      const a = items[cur];
      if (!a) return;
      if (a.kind === 'video') {
        const v = document.createElement('video');
        v.src = API + '/video/' + a.id;
        v.controls = true; v.autoplay = true; v.playsInline = true;
        c.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = API + '/thumb/' + a.id + '?size=full';
        c.appendChild(img);
      }
    }
    function openLb(i) { cur = i; document.getElementById('lb').classList.add('open'); renderLb(); }
    function closeLb() { document.getElementById('lb').classList.remove('open'); document.getElementById('lbContent').innerHTML = ''; }
    function step(d) { if (!items.length) return; cur = (cur + d + items.length) % items.length; renderLb(); }
    document.addEventListener('keydown', (e) => {
      if (!document.getElementById('lb').classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
    // Swipe left/right in the lightbox
    let tx = null;
    document.getElementById('lb').addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
    document.getElementById('lb').addEventListener('touchend', (e) => {
      if (tx == null) return;
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      tx = null;
    }, { passive: true });

    load();
  </script>
</body>
</html>

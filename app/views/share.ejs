<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shared album · Aurora</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#06060c">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --void: #06060c; --panel: rgba(255,255,255,0.05); --border: rgba(255,255,255,0.10);
      --text: rgba(255,255,255,0.92); --text-muted: rgba(255,255,255,0.45);
      --accent: #a78bfa; --accent-sky: #7dd3fc;
    }
    html { background: var(--void); }
    body {
      background: var(--void); color: var(--text); min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .bg span { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.16; mix-blend-mode: screen; }
    .bg span:nth-child(1) { width: 700px; height: 500px; background: var(--accent); top: -120px; left: -150px; }
    .bg span:nth-child(2) { width: 600px; height: 600px; background: var(--accent-sky); bottom: -220px; right: -120px; }
    header {
      position: relative; z-index: 1;
      padding: calc(22px + env(safe-area-inset-top)) 20px 16px;
      border-bottom: 1px solid var(--border);
    }
    .brand { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
    h1 { font-size: 22px; font-weight: 600; }
    .meta { color: var(--text-muted); font-size: 13px; margin-top: 4px; }
    main { position: relative; z-index: 1; padding: 14px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 4px; }
    @media (max-width: 520px) { .grid { grid-template-columns: repeat(3, 1fr); } }
    .tile {
      position: relative; padding-top: 100%; overflow: hidden; border-radius: 6px;
      background: var(--panel); cursor: pointer;
    }
    .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tile .vb {
      position: absolute; top: 6px; left: 6px; background: rgba(0,0,0,0.6);
      border-radius: 4px; padding: 2px 6px; font-size: 10px; color: var(--accent-sky);
    }
    .state { text-align: center; color: var(--text-muted); padding: 80px 20px; font-size: 15px; }
    /* Lightbox */
    .lb {
      position: fixed; inset: 0; z-index: 10; background: rgba(3,3,8,0.96);
      display: none; align-items: center; justify-content: center;
    }
    .lb.open { display: flex; }
    .lb img, .lb video { max-width: 100vw; max-height: 100vh; object-fit: contain; }
    .lb-close, .lb-prev, .lb-next {
      position: absolute; z-index: 11; border: none; cursor: pointer;
      background: rgba(255,255,255,0.08); color: var(--text);
      width: 44px; height: 44px; border-radius: 50%; font-size: 18px; line-height: 1;
    }
    .lb-close { top: max(14px, env(safe-area-inset-top)); right: 14px; }
    .lb-prev { left: 10px; top: 50%; transform: translateY(-50%); }
    .lb-next { right: 10px; top: 50%; transform: translateY(-50%); }
    footer { position: relative; z-index: 1; text-align: center; color: var(--text-muted); font-size: 12px; padding: 26px 0 34px; }
    footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <div class="bg"><span></span><span></span></div>
  <header>
    <div class="brand">✦ Aurora</div>
    <h1 id="albumName">Shared album</h1>
    <div class="meta" id="albumMeta">Loading…</div>
  </header>
  <main>
    <div class="grid" id="grid"></div>
    <div class="state" id="stateMsg" style="display:none;"></div>
  </main>
  <footer>Shared with <span style="color:var(--accent)">Aurora Photos</span></footer>

  <div class="lb" id="lb">
    <button class="lb-close" onclick="closeLb()">✕</button>
    <button class="lb-prev" onclick="step(-1)">‹</button>
    <button class="lb-next" onclick="step(1)">›</button>
    <div id="lbContent"></div>
  </div>

  <script>
    const TOKEN = '<%= token %>';
    const API = '/api/aurora/share/' + TOKEN;
    let items = [], cur = 0;

    function fmtDate(ms) {
      if (!ms) return '';
      return new Date(ms).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
    }

    async function load() {
      const grid = document.getElementById('grid');
      const state = document.getElementById('stateMsg');
      try {
        const res = await fetch(API);
        if (!res.ok) throw new Error('gone');
        const data = await res.json();
        items = data.assets || [];
        document.getElementById('albumName').textContent = data.name;
        document.title = data.name + ' · Aurora';
        const first = items.length ? fmtDate(items[0].taken_at) : '';
        const last = items.length ? fmtDate(items[items.length - 1].taken_at) : '';
        const span = first && last && first !== last ? '  ·  ' + first + ' – ' + last : (first ? '  ·  ' + first : '');
        document.getElementById('albumMeta').textContent =
          data.count + (data.count === 1 ? ' item' : ' items') + span;
        if (!items.length) { state.style.display = 'block'; state.textContent = 'This album is empty.'; return; }
        items.forEach((a, i) => {
          const t = document.createElement('div');
          t.className = 'tile';
          const img = document.createElement('img');
          img.loading = 'lazy'; img.decoding = 'async'; img.alt = '';
          img.src = API + '/thumb/' + a.id;
          t.appendChild(img);
          if (a.kind === 'video') { const b = document.createElement('div'); b.className = 'vb'; b.textContent = '▶'; t.appendChild(b); }
          t.addEventListener('click', () => openLb(i));
          grid.appendChild(t);
        });
      } catch (_) {
        document.getElementById('albumMeta').textContent = '';
        state.style.display = 'block';
        state.textContent = 'This share link is no longer available.';
      }
    }

    function renderLb() {
      const c = document.getElementById('lbContent');
      c.innerHTML = '';
      const a = items[cur];
      if (!a) return;
      if (a.kind === 'video') {
        const v = document.createElement('video');
        v.src = API + '/video/' + a.id;
        v.controls = true; v.autoplay = true; v.playsInline = true;
        c.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = API + '/thumb/' + a.id + '?size=full';
        c.appendChild(img);
      }
    }
    function openLb(i) { cur = i; document.getElementById('lb').classList.add('open'); renderLb(); }
    function closeLb() { document.getElementById('lb').classList.remove('open'); document.getElementById('lbContent').innerHTML = ''; }
    function step(d) { if (!items.length) return; cur = (cur + d + items.length) % items.length; renderLb(); }
    document.addEventListener('keydown', (e) => {
      if (!document.getElementById('lb').classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
    // Swipe left/right in the lightbox
    let tx = null;
    document.getElementById('lb').addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
    document.getElementById('lb').addEventListener('touchend', (e) => {
      if (tx == null) return;
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      tx = null;
    }, { passive: true });

    load();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <title>Aurora · <%= mode === 'setup' ? 'Set up admin' : 'Sign in' %></title>
  <link rel="manifest" href="/aurora-manifest.json">
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/aurora-icon-180.png">
  <style>
    /* Aurora 2 sign-in. The animated aurora backdrop lives here (and on empty
       states) — the app itself keeps a plain black canvas behind photos. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --canvas: #000;
      --surface: rgba(28, 27, 34, 0.72);
      --field: rgba(255, 255, 255, 0.08);
      --sep: rgba(255, 255, 255, 0.12);
      --label: #fff;
      --label-2: rgba(235, 235, 245, 0.62);
      --accent: #a78bfa;
      --accent-ink: #160d33;
      --danger: #ff453a;
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, system-ui, sans-serif;
      --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      color-scheme: dark;
    }
    html, body { height: 100%; background: var(--canvas); }
    body {
      color: var(--label); font-family: var(--font); font-size: 16px; line-height: 1.35;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
      padding: env(safe-area-inset-top, 0px) 16px env(safe-area-inset-bottom, 0px);
      -webkit-font-smoothing: antialiased;
    }
    .aurora-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .aurora-bg span {
      position: absolute; border-radius: 50%; filter: blur(110px);
      opacity: 0.32; mix-blend-mode: screen; animation: drift 32s linear infinite;
    }
    .aurora-bg span:nth-child(1) { width: 640px; height: 460px; background: #a78bfa; top: -120px; left: -160px; }
    .aurora-bg span:nth-child(2) { width: 560px; height: 560px; background: #7dd3fc; bottom: -220px; right: -120px; animation-delay: -12s; }
    .aurora-bg span:nth-child(3) { width: 460px; height: 380px; background: #f0abfc; top: 40%; left: 40%; animation-delay: -20s; }
    @keyframes drift { 0% { transform: translate(0,0) scale(1); } 50% { transform: translate(60px,-40px) scale(1.06); } 100% { transform: translate(0,0) scale(1); } }
    @media (prefers-reduced-motion: reduce) { .aurora-bg span { animation: none; } }
    .card {
      position: relative; z-index: 1; width: min(380px, 100%);
      background: var(--surface); border: 0.5px solid var(--sep); border-radius: 28px;
      padding: 30px 24px 26px;
      -webkit-backdrop-filter: blur(30px); backdrop-filter: blur(30px);
      box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    }
    .mark {
      width: 60px; height: 60px; border-radius: 17px; margin: 0 auto 14px;
      display: flex; align-items: center; justify-content: center; color: #fff;
      background: linear-gradient(135deg, #a78bfa, #7dd3fc 60%, #f0abfc);
      box-shadow: 0 10px 30px rgba(167,139,250,0.35);
    }
    .mark svg { width: 30px; height: 30px; }
    .brand { text-align: center; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--label-2); margin-bottom: 4px; }
    h1 { text-align: center; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px; }
    p.lede { text-align: center; color: var(--label-2); margin-bottom: 18px; font-size: 15px; line-height: 1.45; }
    label { display: block; font-size: 13px; font-weight: 600; color: var(--label-2); margin: 14px 0 6px; }
    input {
      width: 100%; height: 50px; padding: 0 14px;
      background: var(--field); border: 1px solid transparent; border-radius: 14px;
      color: var(--label); font-family: inherit; font-size: 17px; outline: none;
      transition: border-color .15s;
    }
    input:focus { border-color: var(--accent); }
    input.pin { font-family: var(--mono); letter-spacing: 14px; text-align: center; font-size: 24px; padding-left: 24px; }
    button {
      width: 100%; height: 50px; margin-top: 22px;
      background: var(--accent); color: var(--accent-ink);
      font-family: inherit; font-weight: 600; font-size: 17px;
      border: none; border-radius: 25px; cursor: pointer;
    }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    button:active:not(:disabled) { transform: scale(0.98); }
    .msg { margin-top: 14px; padding: 10px 12px; border-radius: 12px; font-size: 14px; display: none; }
    .msg.err { background: rgba(255,69,58,0.14); color: var(--danger); }
    .msg.err.show { display: block; }
    .hint { margin-top: 16px; font-size: 13px; color: var(--label-2); text-align: center; }
  </style>
</head>
<body>
  <div class="aurora-bg"><span></span><span></span><span></span></div>
  <form class="card" id="f" autocomplete="off">
    <div class="mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.8l1.9 6.1 6.3.2-5.1 3.8 1.9 6.2-5-3.7-5 3.7 1.9-6.2-5.1-3.8 6.3-.2z"/></svg></div>
    <div class="brand">Aurora</div>
    <% if (mode === 'setup') { %>
      <h1>Set up admin</h1>
      <p class="lede">This is a fresh install. Pick an admin username and a 4-digit PIN — you'll use these to sign in from now on. You can add more users later.</p>
    <% } else { %>
      <h1>Sign in</h1>
      <p class="lede">Enter your Aurora username and PIN.</p>
    <% } %>
    <label for="u">Username</label>
    <input id="u" name="username" required autofocus autocomplete="username" spellcheck="false">
    <label for="p">4-digit PIN</label>
    <input id="p" name="pin" type="password" class="pin" required inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="<%= mode === 'setup' ? 'new-password' : 'current-password' %>">
    <% if (mode === 'setup') { %>
      <label for="p2">Confirm PIN</label>
      <input id="p2" name="pin2" type="password" class="pin" required inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="new-password">
    <% } %>
    <button type="submit" id="go"><%= mode === 'setup' ? 'Create admin' : 'Sign in' %></button>
    <div class="msg err" id="err"></div>
    <% if (mode === 'setup') { %>
      <p class="hint">This screen only appears on first setup.</p>
    <% } %>
  </form>
  <script>
    (function () {
      var mode = <%- JSON.stringify(mode) %>;
      var next = <%- JSON.stringify(nextUrl || '/aurora') %>;
      var f = document.getElementById('f');
      var err = document.getElementById('err');
      var btn = document.getElementById('go');

      // Numeric-only guard for both PIN boxes (belt + braces alongside pattern=)
      ['p','p2'].forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', function () { el.value = el.value.replace(/\D/g,'').slice(0,4); });
      });

      function showErr(msg) { err.textContent = msg; err.classList.add('show'); }
      function clearErr() { err.textContent = ''; err.classList.remove('show'); }

      f.addEventListener('submit', async function (e) {
        e.preventDefault();
        clearErr();
        var username = document.getElementById('u').value.trim();
        var pin = document.getElementById('p').value;
        if (mode === 'setup') {
          var pin2 = document.getElementById('p2').value;
          if (pin !== pin2) { showErr('PINs do not match.'); return; }
        }
        btn.disabled = true;
        try {
          var res = await fetch('/api/aurora/auth/' + (mode === 'setup' ? 'setup' : 'login'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: username, pin: pin }),
          });
          var body = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(body.error || 'Something went wrong');
          window.location.replace(next);
        } catch (ex) {
          showErr(ex.message);
          btn.disabled = false;
        }
      });
    })();
  </script>
</body>
</html>
